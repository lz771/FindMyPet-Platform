// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//need to make changes on Post table after load the dataset
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id Int @map("user_id") @id @default(autoincrement()) 
  clerkID String? @unique 
  city String? @db.VarChar(100)

  username String @db.VarChar(100) @default("Unknown User")
  posts Post[]
  @@map("users")
}

model Post{
  id Int @map("post_id") @id @default(autoincrement())
  contactEmail String @map("contact_email") @db.VarChar(255)
  createdAt DateTime @map("created_at") @default(now())

  // set last_modified_at to created_at when a post is created (handle on the form submission)
  // add @updatedAt after loading the dataset to database
  lastModifiedAt DateTime @map("last_modified_at") 

  user User @relation(fields: [userID], references: [id], onDelete: Cascade) 
  userID Int
  pet Pet?
  @@index([userID])
  @@index([createdAt])
  @@index([lastModifiedAt])
  @@map("posts")
}

model Pet{
  id Int @map("lost_pet_id") @id @default(autoincrement())
  petName String @db.VarChar(100)
  species Species
  sex Sex
  status Status @default(Lost)
  dateLastSeen DateTime @map("date_last_seen") @db.Date
  description String? @db.VarChar(500) @default("None")
  
  post Post @relation(fields: [postID], references: [id], onDelete: Cascade)
  postID Int @unique
  location Location @relation(fields: [locationID], references: [id])
  locationID Int
  image Image?
  @@index([locationID])
  @@index([petName])
  @@map("lost_pets")
}
 
enum Species{
  Cat
  Dog
  Bird
  Other
}

enum Sex{
  Male
  Female
  Unknown
}

enum Status{
  Lost
  Reunited
}

model Image{
  id Int @map("imageID") @id @default(autoincrement())
  cloudinaryImgID String? @map("cloudinary_img_id") 
  imgUrl String @map("img_url") @default("https://res.cloudinary.com/l0ozosb1/image/upload/v1789613502/no_image.avif")
  imgAltText String @map("img_alt_text") @default("A lost-pet image")

  pet Pet @relation(fields: [petID], references: [id], onDelete: Cascade)
  petID Int @unique
  @@map("images")
}

model Location{
  id Int @map("location_id") @id @default(autoincrement())
  city String @db.VarChar(100)
  state String @db.VarChar(100)
  zipcode String @db.VarChar(100)

  pets Pet[]
  @@unique([city, state, zipcode]) 
  @@index([city])
  @@index([state])
  @@index([zipcode])
  @@map("locations")
}
